# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Authentication
ADMIN_EMAIL=contact@blouseti.shop

# Meta Pixel & Conversions API (CAPI)
# Dataset ID / Pixel ID Meta (ex: 1150720077648867)
NEXT_PUBLIC_META_PIXEL_ID=1150720077648867
META_PIXEL_ID=1150720077648867

# Token d'accès de l'API de conversions Meta (Généré dans Events Manager > Paramètres > API de Conversions > Générer un jeton d'accès)
META_CAPI_ACCESS_TOKEN=EAAB...

# Code de test d'événements Meta (Optionnel, trouvé dans Events Manager > Tester les évènements, ex: TEST12345)
META_TEST_EVENT_CODE=
